extends SceneTree

# Writes site/palette.css, the website's colours, from the game's own palette
# in hud/ui_kit.gd, so the site and the game cannot drift apart. The site's
# style.css uses only these variables for its colours. The Pages workflow
# runs this before every deploy, and tests/test_site_palette.gd fails when the
# committed file is stale.
#
#   godot --headless --path . --script res://tools/site_palette.gd

const OUT := "res://site/palette.css"

# CSS variable -> the ui_kit constant it carries
const NAMES := [
	["navy-deep", "NAVY_DEEP"], ["navy", "NAVY"], ["navy-raised", "NAVY_RAISED"],
	["ink", "INK"], ["ink-soft", "INK_SOFT"], ["ink-faint", "INK_FAINT"],
	["saffron", "SAFFRON"], ["turquoise", "TURQUOISE"], ["magenta", "MAGENTA"],
	["leaf", "LEAF"], ["bad", "BAD"],
]


static func css() -> String:
	var consts: Dictionary = (load("res://hud/ui_kit.gd") as GDScript).get_script_constant_map()
	var lines := PackedStringArray([
		"/* Generated by tools/site_palette.gd from hud/ui_kit.gd. Do not edit:",
		"   change the colours there and rerun it. */",
		":root {",
	])
	for pair: Array in NAMES:
		var c: Color = consts[pair[1]]
		lines.append("  --%s: #%s;" % [pair[0], c.to_html(false)])
	lines.append("}")
	return "\n".join(lines) + "\n"


func _initialize() -> void:
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	if f == null:
		push_error("cannot write " + OUT)
		quit(1)
		return
	f.store_string(css())
	f.close()
	print("wrote " + OUT)
	quit(0)
