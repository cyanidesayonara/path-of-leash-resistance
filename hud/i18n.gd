	"w_a_snack_is_out_on_the_grass_go": {"en": "A snack is out on the grass. Go slowly: the slower you go, the farther you smell.", "ca": "Hi ha un mos a la gespa. Ves a poc a poc: com més a poc a poc, més lluny ensumes.", "es": "Hay un tentempié en el césped. Ve despacio: cuanto más despacio vas, más lejos hueles."},
	"w_use_your_voice": {"en": "Use your voice.", "ca": "Fes servir la veu.", "es": "Usa tu voz."},
	"w_press_at_the_pigeons_it_scatters": {"en": "Press {bark} at the pigeons. It scatters them and stops your human dead.", "ca": "Prem {bark} davant dels coloms. Els espanta i deixa el teu humà clavat.", "es": "Pulsa {bark} ante las palomas. Las espanta y deja a tu humano clavado."},
	"w_the_zoomies": {"en": "The zoomies.", "ca": "La bogeria.", "es": "La locura."},
	"w_hold_to_run_flat_out_it_burns_the": {"en": "Hold {turbo} to run flat out. It burns the green bar.", "ca": "Mantén {turbo} per córrer a tota castanya. Gasta la barra verda.", "es": "Mantén {turbo} para correr a tope. Gasta la barra verde."},
	"w_nature_calls": {"en": "Nature calls.", "ca": "La natura crida.", "es": "Cuando aprieta."},
	"w_grass_earth_or_a_tree_s_pit_is_a": {"en": "Grass, earth or a tree's pit is a good spot. Stand still on one and hold {poop}.", "ca": "Gespa, terra o l'escocell d'un arbre són bons llocs. Atura't en un i mantén {poop}.", "es": "Césped, tierra o el alcorque de un árbol son buen sitio. Párate en uno y mantén {poop}."},
	"w_swing_around_a_post": {"en": "Swing around a post.", "ca": "Gira al voltant d'un pal.", "es": "Gira alrededor de un poste."},
	"w_hold_and_run_past_the_lamppost_the": {"en": "Hold {turbo} and run past the lamppost. The leash catches and slings you around it.", "ca": "Mantén {turbo} i passa corrent pel costat del fanal. La corretja s'hi enganxa i et fa girar.", "es": "Mantén {turbo} y pasa corriendo junto a la farola. La correa se engancha y te hace girar."},
	"w_tetherball": {"en": "Tetherball.", "ca": "Cavallets.", "es": "El tiovivo."},
	"w_your_human_is_waiting_by_the_post": {"en": "Your human is waiting by the post. Run around it twice to wind them up, then pull away.", "ca": "El teu humà t'espera al costat del pal. Fes-hi dues voltes per enrotllar-lo i després estira.", "es": "Tu humano espera junto al poste. Dale dos vueltas para enrollarlo y luego tira."},
	"w_ride_the_ledge": {"en": "Ride the ledge.", "ca": "Per la vora.", "es": "Por el bordillo."},
	"w_hold_and_run_along_the_stone_ledge": {"en": "Hold {turbo} and run along the stone ledge to hop up. Steer against the wobble.", "ca": "Mantén {turbo} i corre per la vora de pedra per pujar-hi. Compensa quan trontollis.", "es": "Mantén {turbo} y corre junto al bordillo de piedra para subirte. Corrige el tambaleo."},
	"w_the_brink": {"en": "The brink.", "ca": "Al límit.", "es": "Al borde."},
	"w_run_at_the_pond_s_edge_when_you": {"en": "Run at the pond's edge. When you wobble, steer away from the water.", "ca": "Corre per la vora de l'estany. Quan trontollis, gira lluny de l'aigua.", "es": "Corre por el borde del estanque. Cuando te tambalees, aléjate del agua."},
	"w_chain_them": {"en": "Chain them.", "ca": "Encadena'ls.", "es": "Encadénalos."},
	"w_land_tricks_back_to_back_a_swing": {"en": "Land tricks back to back, a swing then a grind, and the combo multiplies your bones.", "ca": "Fes trucs un darrere l'altre, un gir i després una lliscada, i el combo multiplica els teus ossos.", "es": "Haz trucos seguidos, un giro y luego un deslizamiento, y el combo multiplica tus huesos."},
	"w_take_a_dare": {"en": "Take a dare.", "ca": "Accepta un repte.", "es": "Acepta un reto."},
	"w_the_kid_on_the_bench_has_dares_bark": {"en": "The kid on the bench has dares. Bark to take one. Losing costs nothing.", "ca": "El nen del banc té reptes. Borda per acceptar-ne un. Perdre no costa res.", "es": "El niño del banco tiene retos. Ladra para aceptar uno. Perder no cuesta nada."},
	"w_practice_yard": {"en": "Practice yard.", "ca": "Pati de pràctiques.", "es": "Patio de prácticas."},
	"w_try_anything_as_long_as_you_like": {"en": "Try anything, as long as you like. Head through the gate when you're done.", "ca": "Prova el que vulguis, tant com vulguis. Quan acabis, surt per la porta.", "es": "Prueba lo que quieras, el rato que quieras. Cuando acabes, sal por la puerta."},
	"w_off_the_leash": {"en": "Off the leash.", "ca": "Sense corretja.", "es": "Sin correa."},
	"w_the_dog_park_is_all_yours_fetch_the": {"en": "The dog park is all yours: fetch the ball, dig the loose dirt, say hi.", "ca": "El parc de gossos és tot teu: busca la pilota, remena la terra i saluda.", "es": "El parque canino es todo tuyo: trae la pelota, escarba la tierra, saluda."},
	# --- the walks: systems/vet.gd --------------------------------------------------------
