	"chase_caught_dog": {"en": "NOBODY WAITED FOR YOU\n\nYou snagged, the leash went tight, and\nthey kept walking. They always keep walking.", "ca": "NINGÚ T'HA ESPERAT\n\nT'has enganxat, la corretja s'ha tibat i\nhan seguit caminant. Sempre segueixen caminant.", "es": "NADIE TE ESPERÓ\n\nTe enganchaste, la correa se tensó y\nsiguieron andando. Siempre siguen andando."},
	"chase_boars_human": {"en": "THE BOARS GOT YOUR HUMAN\n\nThey stood between mama and the picnic basket.\nBig mistake.", "ca": "SENGLARS 1, HUMÀ 0\n\nEs va posar entre la mare i la cistella del pícnic.\nGran error.", "es": "JABALÍES 1, HUMANO 0\n\nSe puso entre mamá jabalí y la cesta del pícnic.\nGran error."},
	"chase_boars_dog": {"en": "ROOTED IN THE DIRT!\n\nYou got bowled over into the acorns.\nMama boar claimed your snacks.", "ca": "DE MORROS A TERRA!\n\nT'han tombat entre les glans.\nLa mare senglar s'ha quedat les teves llaminadures.", "es": "¡DE MORROS EN EL BARRO!\n\nTe tumbaron entre las bellotas.\nMamá jabalí se quedó tus chuches."},
	"chase_correfoc_human": {"en": "SPARKED OUT!\n\nYour human caught firecrackers in their hood.\nThey dropped the phone in panic.", "ca": "ESPURNEJAT!\n\nAl teu humà li han caigut petards a la caputxa.\nHa deixat caure el mòbil del pànic.", "es": "¡CHISPAZO!\n\nA tu humano le cayeron petardos en la capucha.\nSoltó el móvil del pánico."},
	"chase_correfoc_dog": {"en": "TAIL SINGED!\n\nA fire devil's sparkler popped right behind you.\nYou bolted into the nearest doorway.", "ca": "CUA SOCARRADA!\n\nLa bengala d'un diable ha esclatat just darrere teu.\nT'has amagat al primer portal.", "es": "¡COLA CHAMUSCADA!\n\nLa bengala de un diablo estalló justo detrás de ti.\nTe escondiste en el primer portal."},
	"chase_dimoni_human": {"en": "THE DIMONI GOT YOUR HUMAN\n\nThey stopped to film it. It came closer.\nThe phone kept a lovely last video.", "ca": "DIMONI 1, HUMÀ 0\n\nEs va aturar a gravar-lo. Es va acostar.\nEl mòbil guarda un últim vídeo preciós.", "es": "DIMONI 1, HUMANO 0\n\nSe paró a grabarlo. Se acercó.\nEl móvil guarda un último vídeo precioso."},
	"chase_dimoni_dog": {"en": "SCORCHED!\n\nThe Dimoni rolled right over you.\nYou will smell of fireworks for a week.", "ca": "CREMAT!\n\nEl Dimoni t'ha passat per sobre.\nFaràs olor de pólvora una setmana.", "es": "¡CHAMUSCADO!\n\nEl Dimoni te pasó por encima.\nOlerás a pólvora una semana."},
	"chase_security_human": {"en": "GROUNDED!\n\nSecurity took your human's boarding pass.\nThey are on the no-walk list now.", "ca": "SENSE VOL!\n\nSeguretat ha confiscat la targeta d'embarcament del teu humà.\nAra és a la llista de no passejar.", "es": "¡EN TIERRA!\n\nSeguridad le quitó la tarjeta de embarque a tu humano.\nAhora está en la lista de no pasear."},
	"chase_security_dog": {"en": "IN THE CRATE!\n\nSecurity popped you in a travel crate.\nYou went round the carousel twice.", "ca": "AL TRANSPORTÍ!\n\nSeguretat t'ha ficat en un transportí.\nHas fet dues voltes a la cinta.", "es": "¡AL TRANSPORTÍN!\n\nSeguridad te metió en un transportín.\nDiste dos vueltas en la cinta."},
	"chase_goat_human": {"en": "HEADBUTTED!\n\nThe big mountain goat sent your human tumbling into the brambles.\nThe phone went flying down the crag.", "ca": "BANYADA!\n\nLa cabra grossa ha enviat el teu humà als esbarzers.\nEl mòbil ha sortit volant cingle avall.", "es": "¡TOPETAZO!\n\nLa cabra grande mandó a tu humano a las zarzas.\nEl móvil salió volando risco abajo."},
	"chase_goat_dog": {"en": "PINNED BY THE HORNS!\n\nThe alpha goat cornered you against the cliff face.\nYou surrendered your dried sausages.", "ca": "ATRAPAT PER LES BANYES!\n\nLa cabra cap t'ha arraconat contra la roca.\nLi has donat els teus fuets.", "es": "¡ATRAPADO POR LOS CUERNOS!\n\nLa cabra jefa te arrinconó contra la roca.\nLe entregaste tus fuets."},
	"chase_groomer_human": {"en": "GROOMED!\n\nYour human is now part of the piste.\nVery smooth. Corduroy finish.", "ca": "TREPITJAT!\n\nEl teu humà ara forma part de la pista.\nMolt llis. Acabat de pana.", "es": "¡PISADO!\n\nTu humano ya forma parte de la pista.\nMuy liso. Acabado de pana."},
	"chase_groomer_dog": {"en": "PACKED IN SNOW!\n\nThe blade scooped you up with the berm.\nYou came out at the bottom as a snowdog.", "ca": "COLGAT DE NEU!\n\nLa pala t'ha recollit amb la neu.\nHas sortit a baix fet un gos de neu.", "es": "¡ENTERRADO EN NIEVE!\n\nLa pala te recogió con la nieve.\nSaliste abajo hecho un perro de nieve."},
	"chase_vet_human": {"en": "THE VET GOT YOUR HUMAN\n\nThey handed you over for your booster shot.\nYou will never trust them again.", "ca": "VETERINARI 1, HUMÀ 0\n\nT'ha entregat per a la vacuna de record.\nMai més te'n refiaràs.", "es": "VETERINARIO 1, HUMANO 0\n\nTe entregó para la vacuna de refuerzo.\nNunca más te fiarás."},
	"chase_vet_dog": {"en": "CONE OF SHAME!\n\nThe cone slipped over your head.\nThree weeks of bumping into doorways.", "ca": "CON DE LA VERGONYA!\n\nEl con t'ha entrat pel cap.\nTres setmanes xocant amb les portes.", "es": "¡CONO DE LA VERGÜENZA!\n\nEl cono se te metió por la cabeza.\nTres semanas chocando con las puertas."},
	"chase_flood_human": {"en": "THE FLOOD GOT YOUR HUMAN\n\nThey kept walking. The river did not.", "ca": "RIUADA 1, HUMÀ 0\n\nVa seguir caminant. El riu va seguir pujant.", "es": "RIADA 1, HUMANO 0\n\nSiguió andando. El río siguió subiendo."},
	"chase_flood_dog": {"en": "YOU WENT UNDER\n\nThe shallow would have carried you.\nThe deep did not give you back.", "ca": "T'HA ENGOLIT L'AIGUA\n\nL'aigua baixa t'hauria dut.\nLa fonda no t'ha tornat.", "es": "TE TRAGÓ EL AGUA\n\nLo poco hondo te habría llevado.\nLo hondo no te devolvió."},
	"chase_sweeper_human": {"en": "THE SWEEPER GOT YOUR HUMAN\n\nThey never once looked up from the phone.\nYou did try to tell them.", "ca": "ESCOMBRADORA 1, HUMÀ 0\n\nNo va aixecar els ulls del mòbil ni un cop.\nI mira que l'havies avisat.", "es": "BARREDORA 1, HUMANO 0\n\nNo levantó la vista del móvil ni una vez.\nY mira que intentaste avisarle."},
	"chase_sweeper_dog": {"en": "YOU WENT INTO THE BRUSHES\n\nYou came out suspiciously clean.\nThe walk did not come out at all.", "ca": "ET VAN ENGOLIR ELS RASPALLS\n\nN'has sortit sospitosament net.\nEl passeig no n'ha sortit.", "es": "TE TRAGARON LOS CEPILLOS\n\nSaliste sospechosamente limpio.\nEl paseo no salió."},

	# --- the other ways a walk is lost -------------------------------------------------
	"death_edge": {"en": "OFF THE EDGE\n\nYou went over, and your human went with you.", "ca": "PER LA VORA\n\nHi has caigut, i el teu humà amb tu.", "es": "POR EL BORDE\n\nTe caíste, y tu humano contigo."},
	"death_human_manhole": {"en": "YOUR HUMAN WENT DOWN THE MANHOLE\n\nThe phone gets a signal down there.\nThe walk does not.", "ca": "EL TEU HUMÀ, CLAVEGUERA AVALL\n\nAllà baix el mòbil té cobertura.\nEl passeig, no.", "es": "TU HUMANO, ALCANTARILLA ABAJO\n\nAhí abajo el móvil tiene cobertura.\nEl paseo, no."},
	"death_dog_manhole": {"en": "%s WENT DOWN THE MANHOLE\n\nAll fine. The walk is very over.", "ca": "%s, CLAVEGUERA AVALL\n\nTot bé. El passeig, però, s'ha acabat del tot.", "es": "%s, ALCANTARILLA ABAJO\n\nTodo bien. Pero el paseo se acabó, y bien acabado."},
	"death_human_cellar": {"en": "YOUR HUMAN FELL IN THE CELLAR\n\nRight onto the delivery. You did warn them,\nin the only language you have.", "ca": "EL TEU HUMÀ, SOTERRANI AVALL\n\nJust sobre la comanda. Ja l'havies avisat,\nen l'única llengua que tens.", "es": "TU HUMANO, SÓTANO ABAJO\n\nJusto encima del pedido. Ya le avisaste,\nen el único idioma que tienes."},
	"death_dog_cellar": {"en": "%s FELL INTO THE CELLAR\n\nFound the sausages. The walk is still over.", "ca": "%s, SOTERRANI AVALL\n\nHa trobat les salsitxes. El passeig s'ha acabat igualment.", "es": "%s, SÓTANO ABAJO\n\nHa encontrado las salchichas. El paseo se acabó igual."},
	"death_phone": {"en": "PHONE SMASHED\n\nThree cracks and it is gone. Your human is inconsolable,\nand blaming the one member of the household who cannot answer back.", "ca": "MÒBIL DESTROSSAT\n\nTres esquerdes i adeu. El teu humà està inconsolable,\ni culpa l'únic de casa que no pot contestar.", "es": "MÓVIL DESTROZADO\n\nTres grietas y adiós. Tu humano está inconsolable,\ny culpa al único de la casa que no puede contestar."},
	"loss_hint_phone": {"en": "Bikes knock your human over. Dig in at a crossing and keep\nthem out of the bike lane.", "ca": "Les bicis tomben el teu humà. Planta't als passos i\nallunya'l del carril bici.", "es": "Las bicis tumban a tu humano. Plántate en los cruces y\naléjalo del carril bici."},
	"loss_hint_manhole": {"en": "Steer your human around open manholes, or dig in until\nyou are both past.", "ca": "Guia el teu humà lluny de les clavegueres obertes,\no planta't fins que les hàgiu passat.", "es": "Guía a tu humano lejos de las alcantarillas abiertas,\no plántate hasta que las hayáis pasado."},
	"loss_hint_cellar": {"en": "Keep your human off the store side where a cellar\ndoor stands open.", "ca": "Allunya el teu humà del costat de les botigues\nsi hi ha un soterrani obert.", "es": "Aleja a tu humano del lado de las tiendas\nsi hay un sótano abierto."},
	"loss_hint_dog_hole": {"en": "When you wobble at the brink, steer away from the hole.", "ca": "Quan et balancegis, allunya't del forat.", "es": "Cuando te tambalees, apártate del agujero."},
	"loss_hint_edge": {"en": "When you wobble at the brink, steer away from the edge.", "ca": "Quan et balancegis, allunya't de la vora.", "es": "Cuando te tambalees, apártate del borde."},
	"loss_hint_chase": {"en": "Run for home and pull steadily: your human speeds up when\nthe leash leads them.", "ca": "Corre cap a casa i estira amb constància: el teu humà\naccelera quan la corretja el guia.", "es": "Corre a casa y tira con constancia: tu humano\nacelera cuando la correa lo guía."},
	"loss_kept_one": {"en": "This walk ticked a new goal. It stays ticked.", "ca": "Aquest passeig ha marcat una fita nova. Es queda marcada.", "es": "Este paseo ha cumplido una meta nueva. Se queda cumplida."},
	"loss_kept_many": {"en": "This walk ticked %d new goals. They stay ticked.", "ca": "Aquest passeig ha marcat %d fites noves. Es queden marcades.", "es": "Este paseo ha cumplido %d metas nuevas. Se quedan cumplidas."},
	"loss_comfort": {"en": "Everyone loses a walk now and then. It starts fresh every time.", "ca": "Tothom perd un passeig de tant en tant. Cada cop es comença de nou.", "es": "Todo el mundo pierde un paseo de vez en cuando. Siempre se empieza de cero."},

	# --- first-time tips (systems/tips.gd) ----------------------------------------------
	"tip_start": {"en": "{plant} DIGS IN WHEN THEY PULL. {pee} MARKS A SPOT", "ca": "{plant} ET PLANTA QUAN ESTIRA. {pee} MARCA UN LLOC", "es": "{plant} TE PLANTA CUANDO TIRA. {pee} MARCA UN SITIO"},
	"tip_crack": {"en": "KEEP YOUR HUMAN ON THEIR FEET. THREE CRACKS AND THE PHONE IS GONE", "ca": "QUE EL TEU HUMÀ NO CAIGUI. TRES ESQUERDES I ADEU MÒBIL", "es": "QUE TU HUMANO NO SE CAIGA. TRES GRIETAS Y ADIÓS MÓVIL"},
	"tip_teeter": {"en": "WOBBLING! STEER AWAY FROM THE EDGE", "ca": "ET BALANCEGES! ALLUNYA'T DE LA VORA", "es": "¡TE TAMBALEAS! APÁRTATE DEL BORDE"},
	"tip_correct": {"en": "PULL GENTLY AND YOUR HUMAN FOLLOWS. HAUL AND THEY SNAP", "ca": "ESTIRA SUAU I EL TEU HUMÀ ET SEGUEIX. ESTIRA FORT I S'ENFADA", "es": "TIRA SUAVE Y TU HUMANO TE SIGUE. TIRA FUERTE Y SE ENFADA"},
	"tip_whirl": {"en": "WOUND AROUND A POST! PULL AWAY TO SPIN THEM OFF", "ca": "ENROTLLAT A UN PAL! ESTIRA PER FER-LO GIRAR", "es": "¡ENROLLADO EN UN POSTE! TIRA PARA HACERLO GIRAR"},
	"tip_swing": {"en": "HOLD {turbo} AS THE LEASH CATCHES A POST TO SWING AROUND IT", "ca": "MANTÉN {turbo} QUAN LA CORRETJA TOQUI UN PAL PER GIRAR-HI", "es": "MANTÉN {turbo} CUANDO LA CORREA TOQUE UN POSTE PARA GIRAR"},
	"tip_grind": {"en": "HOLD {turbo} RUNNING ALONG A LEDGE TO RIDE IT", "ca": "MANTÉN {turbo} CORRENT PER UNA VORA PER LLISCAR-HI", "es": "MANTÉN {turbo} CORRIENDO POR UN BORDILLO PARA DESLIZARTE"},

	# --- the live dare's hint (main.gd dare_hint) ----------------------------------------
	"dare_counts": {"en": "%s counts!", "ca": "%s compta!", "es": "¡%s cuenta!"},
	"dare_hint_whirl": {"en": "Keep pulling: your human swings round and flies.", "ca": "Continua estirant: el teu humà gira i surt volant.", "es": "Sigue tirando: tu humano gira y sale volando."},
	"dare_hint_grind": {"en": "Hold {turbo} and run along the marked ledge to grind it.", "ca": "Mantén {turbo} i corre per la vora marcada per lliscar-hi.", "es": "Mantén {turbo} y corre por el bordillo marcado para deslizarte."},
	"dare_hint_pole": {"en": "Hold {turbo} and run round a ringed pole or tree.", "ca": "Mantén {turbo} i corre al voltant d'un pal o un arbre amb anella.", "es": "Mantén {turbo} y corre alrededor de un poste o un árbol con aro."},
	"dare_hint_find": {"en": "Hold {turbo} and find a pole to run round.", "ca": "Mantén {turbo} i busca un pal per voltar-hi.", "es": "Mantén {turbo} y busca un poste para rodearlo."},

