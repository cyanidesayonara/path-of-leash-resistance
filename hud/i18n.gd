class_name I18n
extends RefCounted

# The menus' and the walk HUD's words in the player's language (the LANGUAGE
# setting, Game.language): t("key") is the current language's text, English
# where a translation is missing. Each key holds its English, Catalan and
# Spanish side by side, so a reviewer reads the three together.
#
# Place names stay in Catalan in every language (Game.LEVEL_NAMES), and the
# walks' glosses come from Game.gloss. Text with values keeps its format
# placeholders ("%d", "%s") and its Prompts tokens ("{plant}") exactly as the
# English has them; tests/test_i18n.gd holds every entry to that.
#
# A label set once goes through set_text(): refresh() re-fills it when the
# language changes, as Prompts.refresh() does when the device changes.
#
# The walks' words are here too: a script names its shouts, speech and scores
# by key, and lines kept in English tables (who says what, the dares, the
# combo's labels, the lessons) are looked up by their English where they are
# shown. The walk's sinks (main.float_text, EventFeed.say, your human's
# bubble) look up whatever reaches them, so a translation must come back from
# of_english as it went in. A score keeps its amount last ("marcat! +3").

const LANGS: Array[String] = ["en", "ca", "es"]

static var language := "en"
# labels whose text came from set_text: [WeakRef, key, args, text last set]
static var _bound: Array = []
# English text -> its key, the first key with that English (of_english)
static var _by_en: Dictionary = {}


static func t(key: String) -> String:
	var e: Dictionary = T.get(key, {})
	var s := String(e.get(language, ""))
	if s == "":
		s = String(e.get("en", key))
	return s


static func has(key: String) -> bool:
	return T.has(key)


# Text that arrives in English from data the game keeps in English (a chase
# profile's banners and catch cards, a walk's prize): its entry's words in the
# current language, or the text as it came when the table has no entry.
static func of_english(en: String) -> String:
	if language == "en" or en == "":
		return en
	if _by_en.is_empty():
		for k: String in T:
			var e := String(T[k].en)
			if not _by_en.has(e):
				_by_en[e] = k
	return t(_by_en[en]) if _by_en.has(en) else en


static func set_language(lang: String) -> void:
	if lang == language or not lang in LANGS:
		return
	language = lang
	refresh()


static func set_text(label: Object, key: String, args: Variant = null) -> void:
	Prompts.set_text(label, _fill(key, args))
	for entry: Array in _bound:
		if (entry[0] as WeakRef).get_ref() == label:
			entry[1] = key
			entry[2] = args
			entry[3] = label.text
			return
	_bound.append([weakref(label), key, args, label.text])


# Re-fill every label set_text wrote, unless something else has written to it
# since: a label now showing other text keeps it.
static func refresh() -> void:
	var keep: Array = []
	for entry: Array in _bound:
		var label: Object = (entry[0] as WeakRef).get_ref()
		if label == null:
			continue
		if String(label.text) == String(entry[3]):
			Prompts.set_text(label, _fill(String(entry[1]), entry[2]))
			entry[3] = label.text
		keep.append(entry)
	_bound = keep


static func _fill(key: String, args: Variant) -> String:
	return t(key) if args == null else t(key) % args


